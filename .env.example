# ─────────────────────────────────────────────────────────────────────────────
# Orbit environment. Copy to `.env` (all apps read the root .env).
# `pnpm setup` fills local-development values automatically.
# Variables prefixed NEXT_PUBLIC_ are exposed to browsers — never put secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# ── APP ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public origin of the web app (used in emails, share links, OAuth redirects).
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base URL of the API. Empty = same origin (web). Native builds set the hosted URL.
NEXT_PUBLIC_API_URL=
LOG_LEVEL=info
# Feature flag overrides, comma separated (e.g. "-publicLinks,devEntitlements").
FLAGS=
NEXT_PUBLIC_FLAGS=

# ── DATABASE ─────────────────────────────────────────────────────────────────
# Direct Postgres connection used by the API, worker, collaboration and MCP servers.
# Use the session/direct connection (port 5432) or the transaction pooler (6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── SUPABASE ─────────────────────────────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
# Publishable/anon key (safe for browsers; RLS protects data).
SUPABASE_ANON_KEY=
# Service role key — server only. Used for storage signing and audited server flows.
SUPABASE_SERVICE_ROLE_KEY=
# HS256 JWT secret (local/legacy projects). Leave empty to verify via the project's JWKS.
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── STORAGE ──────────────────────────────────────────────────────────────────
STORAGE_BUCKET=orbit-private

# ── AUTH / SECURITY ──────────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts OAuth tokens at rest. Rotate with a re-encryption job.
ENCRYPTION_KEY=
# Shared secret between API/worker/MCP and the collaboration server (≥ 24 chars).
INTERNAL_API_SECRET=

# ── REALTIME / MCP ───────────────────────────────────────────────────────────
# Browser-facing WebSocket URL of the collaboration server.
COLLAB_URL=ws://localhost:4001
# Server-to-server URL of the collaboration server.
COLLAB_INTERNAL_URL=http://localhost:4001
COLLAB_PORT=4001
MCP_PUBLIC_URL=http://localhost:4002/mcp
MCP_PORT=4002

# ── GOOGLE (Gmail, Calendar, Google sign-in) ────────────────────────────────
# OAuth client (Web application). Redirect URI: {APP_URL}/api/integrations/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Pub/Sub topic for Gmail push notifications (projects/<id>/topics/<name>).
GOOGLE_PUBSUB_TOPIC=

# ── APPLE (Sign in with Apple — configured in Supabase Auth) ────────────────
APPLE_CLIENT_ID=
APPLE_SECRET=

# ── SLACK ────────────────────────────────────────────────────────────────────
# Redirect URI: {APP_URL}/api/integrations/callback/slack
# Events/Interactivity/Slash command URL: {APP_URL}/api/webhooks/slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ── GITHUB ───────────────────────────────────────────────────────────────────
# GitHub App (user-to-server OAuth). Callback: {APP_URL}/api/integrations/callback/github
# Webhook URL: {APP_URL}/api/webhooks/github
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── LINEAR ───────────────────────────────────────────────────────────────────
# Callback: {APP_URL}/api/integrations/callback/linear   Webhook: {APP_URL}/api/webhooks/linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# ── MICROSOFT (To Do via Microsoft Graph) ────────────────────────────────────
# Callback: {APP_URL}/api/integrations/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ── EMAIL ────────────────────────────────────────────────────────────────────
# console (dev: logs emails) | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM="Orbit <no-reply@orbit.example>"
# Local Supabase ships Mailpit: smtp://127.0.0.1:54325 (UI at http://127.0.0.1:54324)
SMTP_URL=
RESEND_API_KEY=
# Inbound capture addresses: capture+<token>@INBOUND_EMAIL_DOMAIN
INBOUND_EMAIL_DOMAIN=in.orbit.example
# postmark | resend | generic (HMAC-signed JSON)
INBOUND_EMAIL_PROVIDER=generic
# Webhook secret for inbound email (basic-auth password for Postmark; HMAC key otherwise).
INBOUND_EMAIL_SECRET=

# ── STRIPE ───────────────────────────────────────────────────────────────────
# Webhook endpoint: {APP_URL}/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_YEARLY=
# true = allow the dev-only "grant test plan" control (never in production).
BILLING_DEV_MODE=false

# ── REVENUECAT (App Store / Play Store) ─────────────────────────────────────
# Webhook endpoint: {APP_URL}/api/webhooks/revenuecat (Authorization header must match)
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_API_KEY=
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=

# ── AI ───────────────────────────────────────────────────────────────────────
# anthropic | openai | none
AI_TEXT_PROVIDER=none
# e.g. claude-sonnet-5 / claude-haiku-4-5-20251001 (fast) or gpt-5 / gpt-5-mini
AI_TEXT_MODEL=
AI_FAST_MODEL=
AI_EMBEDDING_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_MS=60000

# ── TRANSCRIPTION ────────────────────────────────────────────────────────────
# openai | deepgram | none
AI_TRANSCRIPTION_PROVIDER=none
AI_TRANSCRIPTION_MODEL=
DEEPGRAM_API_KEY=

# ── PUSH ─────────────────────────────────────────────────────────────────────
# Web Push (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@orbit.example
# APNs token auth (.p8 contents with \n escapes)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=app.orbit.client
APNS_PRODUCTION=false
# FCM HTTP v1 service account
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── ANALYTICS ────────────────────────────────────────────────────────────────
# none | console | posthog   (no task titles or document content are ever sent)
ANALYTICS_PROVIDER=none
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
