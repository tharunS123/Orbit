{
  "name": "@orbit/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@orbit/api": "workspace:*",
    "@orbit/auth": "workspace:*",
    "@orbit/core": "workspace:*",
    "@orbit/database": "workspace:*",
    "@orbit/notifications": "workspace:*",
    "@orbit/shared": "workspace:*",
    "pg-boss": "^12.33.5",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@orbit/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
