{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "identifier": "app.orbit.client",
  "version": "0.1.0",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web/out",
    "beforeBuildCommand": "pnpm --filter @orbit/web build:native"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Orbit",
        "url": "/inbox",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Tasks and context, together.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
